---
import { MapPin, Phone, Clock } from "lucide-react";
import { CLINIC_DATA } from "../../lib/constants";

const phoneWA = CLINIC_DATA.phone.replace("+", "");
---

<section
  id="contacto"
  class="py-16 lg:py-24 bg-primary/10 relative overflow-hidden"
>
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div
      class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center max-w-6xl mx-auto"
    >
      {/* Columna Izquierda: Información */}
      <div>
        <span
          class="text-primary font-bold tracking-widest uppercase text-xs mb-4 block"
          >Contacto</span
        >
        <h2
          class="text-3xl md:text-4xl lg:text-5xl text-slate-900 mb-6 font-bold leading-tight"
        >
          Pedí tu <span class="text-primary">evaluación sin</span> compromiso
        </h2>
        <p class="text-lg text-slate-600 mb-10">
          Completá el formulario o escribinos directo por WhatsApp. Te
          respondemos en minutos.
        </p>

        <div class="space-y-6 mb-12">
          {/* Info Item 1 */}
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 rounded-xl bg-background flex items-center justify-center text-primary shrink-0"
            >
              <MapPin className="w-5 h-5" />
            </div>
            <div>
              <p class="font-bold text-slate-900 text-sm">Dirección</p>
              <p class="text-slate-600 text-sm">{CLINIC_DATA.address}</p>
            </div>
          </div>

          {/* Info Item 2 */}
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 rounded-xl bg-background flex items-center justify-center text-primary shrink-0"
            >
              <Phone className="w-5 h-5" />
            </div>
            <div>
              <p class="font-bold text-slate-900 text-sm">Teléfono</p>
              <p class="text-slate-600 text-sm">{CLINIC_DATA.phone}</p>
            </div>
          </div>

          {/* Info Item 3 */}
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 rounded-xl bg-background flex items-center justify-center text-primary shrink-0"
            >
              <Clock className="w-5 h-5" />
            </div>
            <div>
              <p class="font-bold text-slate-900 text-sm">Horarios</p>
              <p class="text-slate-600 text-sm">
                Lun a Vie · 9:00 a 20:00 · Sáb 9:00 a 13:00
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="bg-background rounded-4xl p-8 md:p-10 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.08)] border border-slate-100 relative"
      >
        <h3 class="text-2xl font-bold text-slate-900 mb-8">Solicitar turno</h3>

        <form id="contactForm" class="space-y-6">
          <input type="hidden" id="waPhone" value={phoneWA} />

          <div>
            <label
              for="name"
              class="block text-sm font-bold text-slate-900 mb-2"
              >Nombre completo *</label
            >
            <input
              type="text"
              id="name"
              required
              class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none text-slate-700 bg-white focus:bg-transparent"
              placeholder="Tu nombre"
            />
          </div>

          {/* Selector de tratamiento */}
          <div>
            <label
              for="treatment"
              class="block text-sm font-bold text-slate-900 mb-2"
              >Tratamiento de interés</label
            >
            <div class="relative">
              <select
                id="treatment"
                class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none text-slate-700 bg-white focus:bg-transparent appearance-none cursor-pointer"
              >
                <option value="">— Sin preferencia —</option>
                <option value="Implantología">Implantología</option>
                <option value="Ortodoncia">Ortodoncia</option>
                <option value="Endodoncia">Endodoncia</option>
                <option value="Periodoncia">Periodoncia</option>
                <option value="Prostodoncia">Prostodoncia</option>
                <option value="Odontología Estética"
                  >Odontología Estética</option
                >
                <option value="Cirugía Oral">Cirugía Oral</option>
                <option value="Armonización Facial">Armonización Facial</option>
              </select>
              {/* Chevron decorativo */}
              <div
                class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"><path d="m6 9 6 6 6-6"></path></svg
                >
              </div>
            </div>
          </div>

          <div>
            <label
              for="message"
              class="block text-sm font-bold text-slate-900 mb-2"
              >Tu consulta</label
            >
            <textarea
              id="message"
              rows="4"
              class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none text-slate-700 bg-white focus:bg-transparent resize-none"
              placeholder="Contanos brevemente qué tratamiento te interesa..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-primary text-white py-4 rounded-xl font-bold text-base hover:bg-primary/80 cursor-pointer transition-all shadow-md hover:shadow-lg mt-4 flex justify-center items-center gap-2 group"
          >
            Enviar y continuar por WhatsApp
          </button>

          <p class="text-center text-xs text-slate-400 mt-4">
            Tus datos son confidenciales y solo se usan para contactarte.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Script para manejar el envío del formulario a WhatsApp
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contactForm");

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();

        const nameInput = document.getElementById("name") as HTMLInputElement;
        const messageInput = document.getElementById(
          "message",
        ) as HTMLTextAreaElement;
        const phoneInput = document.getElementById(
          "waPhone",
        ) as HTMLInputElement;

        if (!nameInput || !phoneInput) return;

        const name = nameInput.value.trim();
        const message = messageInput ? messageInput.value.trim() : "";
        const phone = phoneInput.value;
        const treatmentSelect = document.getElementById(
          "treatment",
        ) as HTMLSelectElement;
        const treatment = treatmentSelect ? treatmentSelect.value : "";

        let text = `Hola, soy ${name}.`;
        if (treatment) {
          text += ` Me interesa consultar sobre: ${treatment}.`;
        }
        if (message) {
          text += ` ${message}`;
        } else if (!treatment) {
          text += ` Me gustaría solicitar un turno.`;
        }

        const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
        window.open(waUrl, "_blank");
      });
    }

    // Auto-fill treatment select from sessionStorage (set by Features section)
    const savedTreatment = sessionStorage.getItem("selectedTreatment");
    if (savedTreatment) {
      const treatmentSelect = document.getElementById(
        "treatment",
      ) as HTMLSelectElement;
      if (treatmentSelect) {
        treatmentSelect.value = savedTreatment;
        // Highlight the select briefly to draw attention
        treatmentSelect.classList.add("border-primary", "bg-primary/5");
        setTimeout(() => {
          treatmentSelect.classList.remove("border-primary", "bg-primary/5");
        }, 2000);
      }
      sessionStorage.removeItem("selectedTreatment");
    }
  });
</script>
