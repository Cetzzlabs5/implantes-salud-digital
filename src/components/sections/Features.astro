---
const treatments = [
  {
    id: "implantologia",
    name: "Implantología",
    tag: "Especialidad principal",
    headline: "Recuperá tu sonrisa para siempre.",
    description:
      "Reemplazamos dientes perdidos con implantes de titanio de última generación (Straumann® y Neodent®). Cada caso se planifica con escáner 3D y guías quirúrgicas para garantizar máxima precisión, mínima invasión y una recuperación rápida. El resultado: una pieza idéntica al diente natural, con garantía de por vida.",
    points: [
      "Implantes Straumann® y Neodent®",
      "Cirugía guiada por 3D",
      "Garantía de por vida",
      "Mínimo tiempo de recuperación",
    ],
  },
  {
    id: "ortodoncia",
    name: "Ortodoncia",
    tag: "Alineación dental",
    headline: "Tu sonrisa alineada, a tu ritmo.",
    description:
      "Ofrecemos brackets tradicionales, autoligables y alineadores transparentes. El diagnóstico se realiza con scanner intraoral para un plan completamente digital y personalizado. Desde correcciones simples hasta casos complejos, encontramos la solución que más se adapta a tu vida.",
    points: [
      "Brackets estéticos y metálicos",
      "Alineadores transparentes",
      "Scanner intraoral digital",
      "Plan de tratamiento personalizado",
    ],
  },
  {
    id: "endodoncia",
    name: "Endodoncia",
    tag: "Tratamiento del interior",
    headline: "Salvamos tu diente, eliminamos el dolor.",
    description:
      "Tratamos infecciones y lesiones del interior dental con instrumental rotatorio de última generación. El procedimiento es prácticamente indoloro gracias a la anestesia moderna y la precisión digital. Preservar tu diente natural siempre es la mejor opción.",
    points: [
      "Instrumental rotatorio avanzado",
      "Prácticamente indoloro",
      "Preserva el diente natural",
      "Alta tasa de éxito a largo plazo",
    ],
  },
  {
    id: "periodoncia",
    name: "Periodoncia",
    tag: "Salud de encías",
    headline: "La salud de tus encías es la base de todo.",
    description:
      "Diagnosticamos y tratamos enfermedades como gingivitis y periodontitis, que son la principal causa de pérdida dental en adultos. El tratamiento periodontal es también condición esencial para el éxito a largo plazo de cualquier implante o rehabilitación.",
    points: [
      "Diagnóstico periodontal completo",
      "Tratamiento de gingivitis y periodontitis",
      "Raspado y alisado radicular",
      "Mantenimiento periodontal continuo",
    ],
  },
  {
    id: "prostodoncia",
    name: "Prostodoncia",
    tag: "Rehabilitación oral",
    headline: "Rehabilitamos tu boca completamente.",
    description:
      "Diseñamos y fabricamos prótesis fijas, removibles y sobre implantes en nuestro laboratorio digital propio, eliminando intermediarios. Cada prótesis se diseña digitalmente para lograr la estética, el confort y la función que merecés.",
    points: [
      "Laboratorio digital in-house",
      "Prótesis fija y removible",
      "Coronas y puentes cerámicos",
      "Prótesis sobre implantes",
    ],
  },
  {
    id: "estetica",
    name: "Odontología Estética",
    tag: "Diseño de sonrisa",
    headline: "La sonrisa que siempre quisiste.",
    description:
      "Carillas de porcelana ultrafinas, blanqueamiento profesional y remodelado dental para transformar tu sonrisa sin alterar la estructura del diente. Cada diseño es único, personalizado a tu anatomía y pensado para que te veas y te sientas increíble.",
    points: [
      "Carillas de porcelana",
      "Blanqueamiento profesional",
      "Diseño digital de sonrisa",
      "Remodelado estético",
    ],
  },
  {
    id: "cirugia",
    name: "Cirugía Oral",
    tag: "Procedimientos quirúrgicos",
    headline: "Cirugía precisa, recuperación rápida.",
    description:
      "Realizamos extracciones simples y complejas, cirugías de terceros molares, regeneración ósea y cirugías pre-protéticas. Todo planificado con tecnología 3D y guías digitales para minimizar el tiempo de intervención y acelerar la recuperación.",
    points: [
      "Extracciones y cordales",
      "Regeneración ósea guiada",
      "Cirugía pre-protética",
      "Planificación 3D preoperatoria",
    ],
  },
  {
    id: "armonizacion",
    name: "Armonización Facial",
    tag: "Medicina estética",
    headline: "Sonrisa y rostro en perfecta armonía.",
    description:
      "Complementamos los tratamientos dentales con técnicas no invasivas de medicina estética: rellenos, toxina botulínica y rinomodelación para armonizar el tercio inferior del rostro. El resultado es una transformación integral que va más allá de la boca.",
    points: [
      "Rellenos con ácido hialurónico",
      "Toxina botulínica",
      "Rinomodelación no quirúrgica",
      "Tratamiento integral rostro y sonrisa",
    ],
  },
];
---

<section class="py-16 lg:py-24 bg-background overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span
        class="text-primary font-bold tracking-widest uppercase text-xs mb-4 block"
        >Lo que hacemos</span
      >
      <h2
        class="text-3xl md:text-4xl lg:text-5xl text-slate-900 font-bold mb-5"
      >
        Nuestros tratamientos
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed">
        Cada tratamiento se diseña a medida, con tecnología avanzada y la
        calidez de un equipo que se preocupa por vos.
      </p>
    </div>

    {/* ══════════════════════════════════════════
        MOBILE: Acordeón (oculto en lg+)
    ══════════════════════════════════════════ */}
    <div class="lg:hidden space-y-3 max-w-2xl mx-auto">
      {
        treatments.map((t, i) => (
          <div class="accordion-item rounded-2xl border border-primary/10 overflow-hidden bg-white shadow-sm">
            {/* Header del acordeón */}
            <button
              class={`accordion-trigger w-full flex items-center justify-between px-5 py-4 text-left transition-colors duration-200 ${i === 0 ? "bg-primary/10" : "bg-white hover:bg-primary/5"}`}
              data-acc={t.id}
              aria-expanded={i === 0 ? "true" : "false"}
            >
              <div>
                <p class={`font-bold text-sm leading-snug ${i === 0 ? "text-slate-900" : "text-slate-600"}`} data-acc-name>
                  {t.name}
                </p>
                <p class={`text-xs mt-0.5 ${i === 0 ? "text-primary" : "text-slate-400"}`} data-acc-tag>
                  {t.tag}
                </p>
              </div>
              {/* Chevron */}
              <svg
                class={`accordion-chevron w-5 h-5 text-primary shrink-0 transition-transform duration-300 ${i === 0 ? "rotate-180" : ""}`}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>

            {/* Contenido expandible — animado con CSS grid */}
            <div
              class={`accordion-content grid transition-[grid-template-rows] duration-300 ease-in-out ${i === 0 ? "grid-rows-[1fr]" : "grid-rows-[0fr]"}`}
              data-acc-panel={t.id}
            >
              <div class="overflow-hidden">
                <div class="px-5 pb-6 pt-4 border-t border-primary/10 bg-white">
                  {/* Tag */}
                  <span class="inline-block text-xs font-bold text-primary uppercase tracking-widest bg-primary/8 px-3 py-1 rounded-full mb-4">
                    {t.tag}
                  </span>

                  {/* Headline */}
                  <h3 class="text-xl font-bold text-slate-900 mb-3 leading-snug">
                    {t.headline}
                  </h3>

                  {/* Descripción */}
                  <p class="text-slate-500 leading-relaxed text-sm mb-5">
                    {t.description}
                  </p>

                  {/* Puntos clave */}
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-5">
                    {t.points.map((point) => (
                      <div class="flex items-start gap-2">
                        <div class="w-4 h-4 rounded-full bg-primary/15 flex items-center justify-center shrink-0 mt-0.5">
                          <svg
                            class="w-2.5 h-2.5 text-primary"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3.5"
                          >
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                        </div>
                        <span class="text-xs text-slate-600 font-medium leading-snug">
                          {point}
                        </span>
                      </div>
                    ))}
                  </div>

                  {/* CTA */}
                  <button
                    class="cta-contact inline-flex items-center gap-2 bg-primary text-primary-foreground px-5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20 cursor-pointer"
                    data-treatment={t.name}
                  >
                    Consultar por este tratamiento
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {/* ══════════════════════════════════════════
        DESKTOP: Tabs + Panel (oculto en mobile)
    ══════════════════════════════════════════ */}
    <div
      class="hidden lg:flex max-w-6xl mx-auto rounded-3xl shadow-[0_8px_50px_rgba(126,179,180,0.18)] border border-primary/10 overflow-hidden flex-row min-h-[480px]"
    >
      {/* Columna izquierda: lista de tabs */}
      <div
        class="w-[38%] bg-primary/15 flex flex-col divide-y divide-slate-200/70 border-r border-slate-200/70"
      >
        {
          treatments.map((t, i) => (
            <button
              class={`treatment-tab w-full text-left px-6 py-4 transition-all duration-200 group relative ${i === 0 ? "bg-white tab-active" : "bg-transparent hover:bg-white/60"}`}
              data-tab={t.id}
              role="tab"
            >
              {/* Indicador lateral activo */}
              <div
                class={`absolute left-0 top-0 bottom-0 w-[3px] rounded-r-full transition-all duration-200 ${i === 0 ? "bg-primary" : "bg-transparent group-hover:bg-primary/30"}`}
                data-indicator
              />

              <p
                class={`font-bold text-sm transition-colors leading-snug ${i === 0 ? "text-slate-900" : "text-slate-500 group-hover:text-slate-800"}`}
                data-name
              >
                {t.name}
              </p>
              <p
                class={`text-xs mt-0.5 transition-colors ${i === 0 ? "text-primary" : "text-slate-400 group-hover:text-slate-500"}`}
                data-tag
              >
                {t.tag}
              </p>
            </button>
          ))
        }
      </div>

      {/* Columna derecha: panel de contenido */}
      <div class="w-[62%] bg-white relative overflow-hidden">
        {/* Glow decorativo de fondo */}
        <div
          class="absolute top-0 right-0 w-72 h-72 bg-primary/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
        ></div>

        {
          treatments.map((t, i) => (
            <div
              class={`treatment-panel h-full flex flex-col justify-between p-8 lg:p-10 ${i === 0 ? "flex" : "hidden"}`}
              data-panel={t.id}
            >
              <div>
                {/* Tag */}
                <span class="inline-block text-xs font-bold text-primary uppercase tracking-widest bg-primary/8 px-3 py-1.5 rounded-full mb-6">
                  {t.tag}
                </span>

                {/* Headline */}
                <h3 class="text-2xl lg:text-[1.75rem] font-bold text-slate-900 mb-4 leading-snug">
                  {t.headline}
                </h3>

                {/* Descripción */}
                <p class="text-slate-500 leading-relaxed text-sm mb-8 max-w-lg">
                  {t.description}
                </p>

                {/* Puntos clave en grid 2x2 */}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                  {t.points.map((point) => (
                    <div class="flex items-start gap-2.5">
                      <div class="w-4 h-4 rounded-full bg-primary/15 flex items-center justify-center shrink-0 mt-0.5">
                        <svg
                          class="w-2.5 h-2.5 text-primary"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3.5"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                      </div>
                      <span class="text-xs text-slate-600 font-medium leading-snug">
                        {point}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              {/* CTA al fondo */}
              <div class="pt-6 border-t border-slate-100">
                <button
                  class="cta-contact inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-3 rounded-2xl font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20 cursor-pointer"
                  data-treatment={t.name}
                >
                  Consultar por este tratamiento
                  <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </button>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // ── DESKTOP: tabs ──────────────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>(".treatment-tab");
  const panels = document.querySelectorAll<HTMLDivElement>(".treatment-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const targetId = tab.dataset.tab;

      // Reset all tabs
      tabs.forEach((t) => {
        t.classList.remove("bg-white", "tab-active");
        const indicator = t.querySelector("[data-indicator]");
        if (indicator) {
          indicator.classList.remove("bg-primary");
          indicator.classList.add("bg-transparent");
        }
        const name = t.querySelector("[data-name]");
        if (name) {
          name.classList.remove("text-slate-900");
          name.classList.add("text-slate-500");
        }
        const tag = t.querySelector("[data-tag]");
        if (tag) {
          tag.classList.remove("text-primary");
          tag.classList.add("text-slate-400");
        }
      });

      // Activate clicked tab
      tab.classList.add("bg-white", "tab-active");
      const indicator = tab.querySelector("[data-indicator]");
      if (indicator) {
        indicator.classList.add("bg-primary");
        indicator.classList.remove("bg-transparent");
      }
      const name = tab.querySelector("[data-name]");
      if (name) {
        name.classList.add("text-slate-900");
        name.classList.remove("text-slate-500");
      }
      const tag = tab.querySelector("[data-tag]");
      if (tag) {
        tag.classList.add("text-primary");
        tag.classList.remove("text-slate-400");
      }

      // Show matching panel
      panels.forEach((p) => {
        if (p.dataset.panel === targetId) {
          p.classList.remove("hidden");
          p.classList.add("flex");
        } else {
          p.classList.add("hidden");
          p.classList.remove("flex");
        }
      });
    });
  });

  // ── MOBILE: acordeón ──────────────────────────────────────────────────────
  const triggers = document.querySelectorAll<HTMLButtonElement>(".accordion-trigger");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const targetId = trigger.dataset.acc;
      const isExpanded = trigger.getAttribute("aria-expanded") === "true";

      // Cerrar todos
      triggers.forEach((t) => {
        const panelId = t.dataset.acc;
        const panel = document.querySelector<HTMLDivElement>(`[data-acc-panel="${panelId}"]`);
        const chevron = t.querySelector(".accordion-chevron");
        const accName = t.querySelector("[data-acc-name]");
        const accTag = t.querySelector("[data-acc-tag]");

        t.setAttribute("aria-expanded", "false");
        t.classList.remove("bg-primary/10");
        t.classList.add("bg-white");
        if (panel) {
          panel.classList.remove("grid-rows-[1fr]");
          panel.classList.add("grid-rows-[0fr]");
        }
        if (chevron) chevron.classList.remove("rotate-180");
        if (accName) {
          accName.classList.remove("text-slate-900");
          accName.classList.add("text-slate-600");
        }
        if (accTag) {
          accTag.classList.remove("text-primary");
          accTag.classList.add("text-slate-400");
        }
      });

      // Abrir el clickeado (toggle)
      if (!isExpanded) {
        const panel = document.querySelector<HTMLDivElement>(`[data-acc-panel="${targetId}"]`);
        const chevron = trigger.querySelector(".accordion-chevron");
        const accName = trigger.querySelector("[data-acc-name]");
        const accTag = trigger.querySelector("[data-acc-tag]");

        trigger.setAttribute("aria-expanded", "true");
        trigger.classList.add("bg-primary/10");
        trigger.classList.remove("bg-white");
        if (panel) {
          panel.classList.add("grid-rows-[1fr]");
          panel.classList.remove("grid-rows-[0fr]");
        }
        if (chevron) chevron.classList.add("rotate-180");
        if (accName) {
          accName.classList.add("text-slate-900");
          accName.classList.remove("text-slate-600");
        }
        if (accTag) {
          accTag.classList.add("text-primary");
          accTag.classList.remove("text-slate-400");
        }
      }
    });
  });

  // ── CTA → scroll a contacto ───────────────────────────────────────────────
  document
    .querySelectorAll<HTMLButtonElement>(".cta-contact")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const treatment = btn.dataset.treatment || "";

        const treatmentSelect = document.getElementById(
          "treatment",
        ) as HTMLSelectElement;
        if (treatmentSelect && treatment) {
          treatmentSelect.value = treatment;
          treatmentSelect.classList.add("border-primary", "!bg-primary/5");
          setTimeout(() => {
            treatmentSelect.classList.remove("border-primary", "!bg-primary/5");
          }, 2000);
        }

        const contactSection = document.getElementById("contacto");
        if (contactSection) {
          contactSection.scrollIntoView({ behavior: "smooth" });
        }
      });
    });
</script>

