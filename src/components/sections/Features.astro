---

<section class="py-16 lg:py-24 bg-background overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-primary font-bold tracking-widest uppercase text-xs mb-4 block"
        >Lo que hacemos</span
      >
      <h2
        class="text-3xl md:text-4xl lg:text-5xl text-slate-900 font-bold mb-6"
      >
        Nuestros tratamientos
      </h2>
      <p class="text-lg text-slate-600">
        Cada tratamiento se diseña a medida, con tecnología avanzada y la
        calidez de un equipo que se preocupa por vos.
      </p>
    </div>

    {/* Layout interactivo: lista izquierda + panel derecho */}
    <div
      class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-4 lg:gap-8 items-start"
    >
      {/* Columna izquierda: lista de tratamientos */}
      <div
        class="w-full lg:w-2/5 flex flex-col gap-1 lg:sticky lg:top-24"
        role="tablist"
      >
        {
          treatments.map((t, i) => (
            <button
              class={`treatment-tab w-full flex items-center gap-4 px-5 py-4 rounded-2xl text-left transition-all duration-200 group ${i === 0 ? "active-tab bg-white shadow-[0_4px_20px_rgba(126,179,180,0.2)] border border-primary/30" : "hover:bg-white/70 border border-transparent"}`}
              data-tab={t.id}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              <div
                class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 transition-all duration-300 ${i === 0 ? "bg-primary text-primary-foreground" : "bg-slate-100 text-slate-500 group-hover:bg-primary/10 group-hover:text-primary"}`}
                data-icon
              >
                <Fragment set:html={t.icon} />
              </div>
              <div class="flex-1 min-w-0">
                <p
                  class={`font-bold text-sm transition-colors ${i === 0 ? "text-slate-900" : "text-slate-600 group-hover:text-slate-900"}`}
                  data-name
                >
                  {t.name}
                </p>
                <p
                  class={`text-xs mt-0.5 transition-colors ${i === 0 ? "text-primary" : "text-slate-400 group-hover:text-primary/70"}`}
                  data-tag
                >
                  {t.tag}
                </p>
              </div>
              <svg
                class={`w-4 h-4 transition-all shrink-0 ${i === 0 ? "text-primary rotate-0" : "text-slate-300 -rotate-90 group-hover:text-primary/50"}`}
                data-arrow
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </button>
          ))
        }
      </div>

      {/* Columna derecha: panel de contenido */}
      <div class="w-full lg:w-3/5 relative">
        {
          treatments.map((t, i) => (
            <div
              class={`treatment-panel rounded-3xl bg-white border border-primary/10 shadow-[0_8px_40px_rgba(126,179,180,0.15)] p-8 lg:p-10 transition-all duration-300 ${i === 0 ? "block" : "hidden"}`}
              data-panel={t.id}
            >
              {/* Tag */}
              <span class="inline-block text-xs font-bold text-primary uppercase tracking-widest bg-primary/10 px-3 py-1.5 rounded-full mb-6">
                {t.tag}
              </span>

              {/* Icon grande */}
              <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center text-primary mb-6 border border-primary/20">
                <Fragment set:html={t.icon} />
              </div>

              {/* Headline */}
              <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-4 leading-snug">
                {t.headline}
              </h3>

              {/* Descripción */}
              <p class="text-slate-600 leading-relaxed mb-8">{t.description}</p>

              {/* Puntos clave */}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                {t.points.map((point) => (
                  <div class="flex items-start gap-3">
                    <div class="w-5 h-5 rounded-full bg-primary/15 flex items-center justify-center shrink-0 mt-0.5">
                      <svg
                        class="w-3 h-3 text-primary"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </div>
                    <span class="text-sm text-slate-700 font-medium">
                      {point}
                    </span>
                  </div>
                ))}
              </div>

              {/* CTA */}
              <a
                href="#contacto"
                class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-3 rounded-full font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20"
              >
                Consultar por este tratamiento
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".treatment-tab");
  const panels = document.querySelectorAll<HTMLDivElement>(".treatment-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const targetId = tab.dataset.tab;

      // Reset all tabs
      tabs.forEach((t) => {
        t.classList.remove(
          "active-tab",
          "bg-white",
          "shadow-[0_4px_20px_rgba(126,179,180,0.2)]",
          "border-primary/30",
        );
        t.classList.add("border-transparent");
        const icon = t.querySelector("[data-icon]");
        if (icon) {
          icon.classList.remove("bg-primary", "text-primary-foreground");
          icon.classList.add("bg-slate-100", "text-slate-500");
        }
        const name = t.querySelector("[data-name]");
        if (name) {
          name.classList.remove("text-slate-900");
          name.classList.add("text-slate-600");
        }
        const tag = t.querySelector("[data-tag]");
        if (tag) {
          tag.classList.remove("text-primary");
          tag.classList.add("text-slate-400");
        }
        const arrow = t.querySelector("[data-arrow]");
        if (arrow) {
          arrow.classList.remove("text-primary", "rotate-0");
          arrow.classList.add("text-slate-300", "-rotate-90");
        }
      });

      // Activate clicked tab
      tab.classList.add(
        "active-tab",
        "bg-white",
        "shadow-[0_4px_20px_rgba(126,179,180,0.2)]",
        "border-primary/30",
      );
      tab.classList.remove("border-transparent");
      const icon = tab.querySelector("[data-icon]");
      if (icon) {
        icon.classList.add("bg-primary", "text-primary-foreground");
        icon.classList.remove("bg-slate-100", "text-slate-500");
      }
      const name = tab.querySelector("[data-name]");
      if (name) {
        name.classList.add("text-slate-900");
        name.classList.remove("text-slate-600");
      }
      const tag = tab.querySelector("[data-tag]");
      if (tag) {
        tag.classList.add("text-primary");
        tag.classList.remove("text-slate-400");
      }
      const arrow = tab.querySelector("[data-arrow]");
      if (arrow) {
        arrow.classList.add("text-primary", "rotate-0");
        arrow.classList.remove("text-slate-300", "-rotate-90");
      }

      // Show target panel, hide rest
      panels.forEach((p) => {
        if (p.dataset.panel === targetId) {
          p.classList.remove("hidden");
          p.classList.add("block");
        } else {
          p.classList.add("hidden");
          p.classList.remove("block");
        }
      });
    });
  });
</script>
