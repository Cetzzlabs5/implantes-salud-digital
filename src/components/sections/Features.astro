---

<section class="py-16 lg:py-24 bg-background overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span
        class="text-primary font-bold tracking-widest uppercase text-xs mb-4 block"
        >Lo que hacemos</span
      >
      <h2
        class="text-3xl md:text-4xl lg:text-5xl text-slate-900 font-bold mb-5"
      >
        Nuestros tratamientos
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed">
        Cada tratamiento se diseña a medida, con tecnología avanzada y la
        calidez de un equipo que se preocupa por vos.
      </p>
    </div>

    {/* Contenedor principal: como una sola tarjeta dividida */}
    <div
      class="max-w-6xl mx-auto rounded-3xl shadow-[0_8px_50px_rgba(126,179,180,0.18)] border border-primary/10 overflow-hidden flex flex-col lg:flex-row min-h-[480px]"
    >
      {/* Columna izquierda: lista de tabs */}
      <div
        class="w-full lg:w-[38%] bg-primary/15 flex flex-col divide-y divide-slate-200/70 border-b lg:border-b-0 lg:border-r border-slate-200/70"
      >
        {
          treatments.map((t, i) => (
            <button
              class={`treatment-tab w-full text-left px-6 py-4 transition-all duration-200 group relative ${i === 0 ? "bg-white tab-active" : "bg-transparent hover:bg-white/60"}`}
              data-tab={t.id}
              role="tab"
            >
              {/* Indicador lateral activo */}
              <div
                class={`absolute left-0 top-0 bottom-0 w-[3px] rounded-r-full transition-all duration-200 ${i === 0 ? "bg-primary" : "bg-transparent group-hover:bg-primary/30"}`}
                data-indicator
              />

              <p
                class={`font-bold text-sm transition-colors leading-snug ${i === 0 ? "text-slate-900" : "text-slate-500 group-hover:text-slate-800"}`}
                data-name
              >
                {t.name}
              </p>
              <p
                class={`text-xs mt-0.5 transition-colors ${i === 0 ? "text-primary" : "text-slate-400 group-hover:text-slate-500"}`}
                data-tag
              >
                {t.tag}
              </p>
            </button>
          ))
        }
      </div>

      {/* Columna derecha: panel de contenido */}
      <div class="w-full lg:w-[62%] bg-white relative overflow-hidden">
        {/* Glow decorativo de fondo */}
        <div
          class="absolute top-0 right-0 w-72 h-72 bg-primary/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
        >
        </div>

        {
          treatments.map((t, i) => (
            <div
              class={`treatment-panel h-full flex flex-col justify-between p-8 lg:p-10 ${i === 0 ? "flex" : "hidden"}`}
              data-panel={t.id}
            >
              <div>
                {/* Tag */}
                <span class="inline-block text-xs font-bold text-primary uppercase tracking-widest bg-primary/8 px-3 py-1.5 rounded-full mb-6">
                  {t.tag}
                </span>

                {/* Headline */}
                <h3 class="text-2xl lg:text-[1.75rem] font-bold text-slate-900 mb-4 leading-snug">
                  {t.headline}
                </h3>

                {/* Descripción */}
                <p class="text-slate-500 leading-relaxed text-sm mb-8 max-w-lg">
                  {t.description}
                </p>

                {/* Puntos clave en grid 2x2 */}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                  {t.points.map((point) => (
                    <div class="flex items-start gap-2.5">
                      <div class="w-4 h-4 rounded-full bg-primary/15 flex items-center justify-center shrink-0 mt-0.5">
                        <svg
                          class="w-2.5 h-2.5 text-primary"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3.5"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                      </div>
                      <span class="text-xs text-slate-600 font-medium leading-snug">
                        {point}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              {/* CTA al fondo */}
              <div class="pt-6 border-t border-slate-100">
                <button
                  class="cta-contact inline-flex items-center gap-2 bg-primary text-primary-foreground px-6 py-3 rounded-2xl font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20 cursor-pointer"
                  data-treatment={t.name}
                >
                  Consultar por este tratamiento
                  <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </button>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".treatment-tab");
  const panels = document.querySelectorAll<HTMLDivElement>(".treatment-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const targetId = tab.dataset.tab;

      // Reset all tabs
      tabs.forEach((t) => {
        t.classList.remove("bg-white", "tab-active");
        const indicator = t.querySelector("[data-indicator]");
        if (indicator) {
          indicator.classList.remove("bg-primary");
          indicator.classList.add("bg-transparent");
        }
        const name = t.querySelector("[data-name]");
        if (name) {
          name.classList.remove("text-slate-900");
          name.classList.add("text-slate-500");
        }
        const tag = t.querySelector("[data-tag]");
        if (tag) {
          tag.classList.remove("text-primary");
          tag.classList.add("text-slate-400");
        }
      });

      // Activate clicked tab
      tab.classList.add("bg-white", "tab-active");
      const indicator = tab.querySelector("[data-indicator]");
      if (indicator) {
        indicator.classList.add("bg-primary");
        indicator.classList.remove("bg-transparent");
      }
      const name = tab.querySelector("[data-name]");
      if (name) {
        name.classList.add("text-slate-900");
        name.classList.remove("text-slate-500");
      }
      const tag = tab.querySelector("[data-tag]");
      if (tag) {
        tag.classList.add("text-primary");
        tag.classList.remove("text-slate-400");
      }

      // Show matching panel
      panels.forEach((p) => {
        if (p.dataset.panel === targetId) {
          p.classList.remove("hidden");
          p.classList.add("flex");
        } else {
          p.classList.add("hidden");
          p.classList.remove("flex");
        }
      });
    });
  });

  // CTA → Contact: set the treatment select directly (DOM already loaded) then scroll
  document
    .querySelectorAll<HTMLButtonElement>(".cta-contact")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const treatment = btn.dataset.treatment || "";

        // Set select value directly — all sections are already in the DOM
        const treatmentSelect = document.getElementById(
          "treatment",
        ) as HTMLSelectElement;
        if (treatmentSelect && treatment) {
          treatmentSelect.value = treatment;
          // Brief highlight to draw attention to the pre-filled field
          treatmentSelect.classList.add("border-primary", "!bg-primary/5");
          setTimeout(() => {
            treatmentSelect.classList.remove("border-primary", "!bg-primary/5");
          }, 2000);
        }

        // Smooth scroll to contact section
        const contactSection = document.getElementById("contacto");
        if (contactSection) {
          contactSection.scrollIntoView({ behavior: "smooth" });
        }
      });
    });
</script>
