---
// Año de inicio: 2004. Se calcula automáticamente.
const foundedYear = 2004;
const yearsOfExperience = new Date().getFullYear() - foundedYear;

const stats = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    value: "+11.000",
    label: "Pacientes felices",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`,
    value: `+${yearsOfExperience}`,
    label: "Años de experiencia",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    value: "4.8",
    label: "En Google",
  },
];

const reviews = [
  {
    name: "Marvin Arancibia",
    treatment: "Implante de Carga Inmediata",
    time: "Hace 2 semanas",
    image: "https://randomuser.me/api/portraits/men/32.jpg",
    rating: 5,
    text: "Este lugar transmite confianza desde el primer momento. Llegué con mucho miedo por una mala experiencia previa, pero me explicaron todo el proceso del implante con una paciencia increíble. La cirugía fue sin dolor y muy rápida. Me fui tranquilo y con mi diente nuevo el mismo día. Lo recomiendo sin dudarlo.",
  },
  {
    name: "Javier Albornoz",
    treatment: "Diseño de Sonrisa 3D",
    time: "Hace 1 mes",
    image: "https://randomuser.me/api/portraits/men/44.jpg",
    rating: 5,
    text: "Excelentes profesionales. Se nota que cada uno conoce su trabajo y está comprometido. Me hicieron un diseño de sonrisa digital y el resultado superó mis expectativas, quedó muy natural. La atención fue de primera desde el escaneo 3D hasta el final, con mucha dedicación. ¡Totalmente recomendados!",
  },
  {
    name: "Ruben Veizaga",
    treatment: "Prótesis sobre Implantes",
    time: "Hace 3 meses",
    image: "https://randomuser.me/api/portraits/men/68.jpg",
    rating: 5,
    text: "Llevaba años usando una prótesis removible incómoda. Acá me dieron la opción de fijarla con implantes y me cambió la vida por completo. Ahora puedo comer de todo con total seguridad y comodidad. El trato humano que tienen es excepcional. Muy agradecido con todo el equipo de la clínica.",
  },
];
---

<section id="testimonios" class="py-16 lg:py-20 bg-background">
  <div class="container mx-auto px-4 md:px-6">
    {/* Barra de estadísticas */}
    <div class="grid grid-cols-3 sm:grid-cols-3 gap-3 sm:gap-4 mb-16 max-w-4xl mx-auto">
      {
        stats.map((stat) => (
          <div class="flex flex-col items-center justify-center gap-2 sm:gap-3 p-4 sm:p-6 rounded-2xl border border-primary/20 shadow-[0_4px_20px_rgba(126,179,180,0.15)] bg-white hover:shadow-[0_10px_30px_rgba(126,179,180,0.3)] hover:-translate-y-1 transition-all duration-300 group">
            <div
              class="text-primary group-hover:scale-110 transition-transform duration-300 scale-75 sm:scale-100"
              set:html={stat.icon}
            />
            <p class="text-xl sm:text-3xl font-extrabold text-primary tracking-tight">
              {stat.value}
            </p>
            <p class="text-[10px] sm:text-sm text-slate-500 font-medium text-center leading-tight">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>

    {/* Título */}
    <div class="text-center mb-10 sm:mb-12">
      <span
        class="text-primary font-bold tracking-widest uppercase text-xs mb-3 block"
        >Testimonios Reales</span
      >
      <h2 class="text-3xl md:text-4xl lg:text-5xl text-slate-900 font-bold">
        Lo que dicen nuestros <span class="text-primary">pacientes</span>
      </h2>
    </div>

    {/* ══ MOBILE: Carrusel con scroll-snap ══ */}
    <div class="md:hidden relative">
      {/* Track deslizable */}
      <div
        id="testimonials-track"
        class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-4 px-4"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {
          reviews.map((review, i) => (
            <div
              class="testimonial-slide snap-center shrink-0 w-[85vw] sm:w-[70vw] bg-white border border-primary/20 rounded-2xl p-6 shadow-[0_4px_20px_rgba(126,179,180,0.15)] flex flex-col gap-4"
              data-slide={i}
            >
              {/* Header: Avatar y Nombre */}
              <div class="flex items-center gap-3">
                <img src={review.image} alt={review.name} class="w-10 h-10 rounded-full object-cover shadow-sm" loading="lazy" />
                <div>
                  <p class="text-slate-900 font-semibold text-sm leading-tight">{review.name}</p>
                  <p class="text-slate-500 text-[11px] mt-0.5">{review.time}</p>
                </div>
                <div class="ml-auto">
                  {/* Icono G de Google */}
                  <svg viewBox="0 0 24 24" class="w-5 h-5 text-slate-200">
                    <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                  </svg>
                </div>
              </div>

              <div class="flex flex-col gap-2 grow">
                {/* Estrellas */}
                <div class="flex items-center gap-2">
                  <div class="flex gap-0.5">
                    {Array.from({ length: review.rating }).map(() => (
                      <svg class="w-3.5 h-3.5 text-[#FBBC05] fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    ))}
                  </div>
                  <span class="text-[10px] font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">{review.treatment}</span>
                </div>

                {/* Reseña */}
                <p class="text-slate-700 text-[13px] leading-relaxed">
                  {review.text}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      {/* Controles: dots izquierda · flechas derecha — igual que PatientJourney */}
      <div class="flex items-center justify-between mt-5 px-1">
        {/* Dots */}
        <div id="testimonials-dots" class="flex gap-2">
          {
            reviews.map((_, i) => (
              <button
                class={`testimonial-dot rounded-full transition-all duration-300 h-2 ${i === 0 ? "bg-primary w-5" : "bg-primary/25 w-2"}`}
                data-dot={i}
                aria-label={`Ir al testimonio ${i + 1}`}
              ></button>
            ))
          }
        </div>

        {/* Flechas */}
        <div class="flex gap-2">
          <button
            id="testimonials-prev"
            aria-label="Anterior"
            class="w-9 h-9 rounded-full border border-primary/30 bg-white flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all duration-200 shadow-sm"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </button>
          <button
            id="testimonials-next"
            aria-label="Siguiente"
            class="w-9 h-9 rounded-full border border-primary/30 bg-white flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all duration-200 shadow-sm"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    {/* ══ DESKTOP: Grid 3 columnas ══ */}
    <div class="hidden md:grid grid-cols-3 gap-6 max-w-6xl mx-auto">
      {
        reviews.map((review) => (
          <div class="bg-white border border-primary/20 rounded-2xl p-7 shadow-[0_4px_20px_rgba(126,179,180,0.15)] hover:shadow-[0_12px_35px_rgba(126,179,180,0.3)] hover:-translate-y-1 transition-all duration-300 flex flex-col gap-4">
            {/* Header: Avatar y Nombre */}
            <div class="flex items-center gap-3">
              <img src={review.image} alt={review.name} class="w-10 h-10 rounded-full object-cover shadow-sm" loading="lazy" />
              <div>
                <p class="text-slate-900 font-semibold text-sm leading-tight">{review.name}</p>
                <p class="text-slate-500 text-xs mt-0.5">{review.time}</p>
              </div>
              <div class="ml-auto">
                {/* Icono G de Google */}
                <svg viewBox="0 0 24 24" class="w-5 h-5 text-slate-200">
                  <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              </div>
            </div>

            <div class="flex flex-col gap-2 grow">
              {/* Estrellas */}
              <div class="flex items-center gap-2">
                <div class="flex gap-0.5">
                  {Array.from({ length: review.rating }).map(() => (
                    <svg class="w-4 h-4 text-[#FBBC05] fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  ))}
                </div>
                <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">{review.treatment}</span>
              </div>

              {/* Reseña */}
              <p class="text-slate-700 text-sm leading-relaxed">
                {review.text}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Ocultar scrollbar del track en webkit */
  #testimonials-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const track = document.getElementById("testimonials-track") as HTMLElement | null;
    const slides = Array.from(document.querySelectorAll<HTMLElement>(".testimonial-slide"));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".testimonial-dot"));
    const prevBtn = document.getElementById("testimonials-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("testimonials-next") as HTMLButtonElement | null;

    if (!track || slides.length === 0) return;

    let current = 0;
    const total = slides.length;

    function updateDots() {
      dots.forEach((dot, i) => {
        if (i === current) {
          dot.classList.add("bg-primary", "w-5");
          dot.classList.remove("bg-primary/25", "w-2");
        } else {
          dot.classList.remove("bg-primary", "w-5");
          dot.classList.add("bg-primary/25", "w-2");
        }
      });
    }

    function updateArrows() {
      if (prevBtn) prevBtn.style.opacity = current === 0 ? "0.3" : "1";
      if (nextBtn) nextBtn.style.opacity = current === total - 1 ? "0.3" : "1";
    }

    function goTo(index: number) {
      current = Math.max(0, Math.min(index, total - 1));
      const slide = slides[current];
      // scrollLeft relativo al track — track is guaranteed non-null by the early return above
      track!.scrollTo({
        left: slide.offsetLeft - 16,
        behavior: "smooth",
      });
      updateDots();
      updateArrows();
    }

    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    // Sincronizar al hacer swipe manual
    let scrollTimer: ReturnType<typeof setTimeout>;
    track.addEventListener("scroll", () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const trackLeft = track.getBoundingClientRect().left;
        let closest = 0;
        let minDist = Infinity;
        slides.forEach((slide, i) => {
          const dist = Math.abs(slide.getBoundingClientRect().left - trackLeft);
          if (dist < minDist) { minDist = dist; closest = i; }
        });
        if (closest !== current) {
          current = closest;
          updateDots();
          updateArrows();
        }
      }, 80);
    });

    // Init
    updateDots();
    updateArrows();
  });
</script>

