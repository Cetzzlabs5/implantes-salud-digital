---
import { CLINIC_DATA } from "../../lib/constants";

const steps = [
  {
    number: "01",
    step: "Primero",
    title: "Hacemos tu diagnóstico 3D",
    subtitle: "Sin moldes. Sin esperas.",
    image: "/images/journey-step1.png",
    description:
      "Escaneamos tu boca en minutos con un escáner intraoral de última generación. Sin moldes incómodos y con un 90% menos de radiación que los métodos tradicionales. Ves tu diagnóstico digital en pantalla al instante.",
  },
  {
    number: "02",
    step: "Luego",
    title: "Simulamos tu sonrisa ideal",
    subtitle: "Aprobás el resultado antes de empezar.",
    image: "/images/journey-step2.png",
    description:
      "A través de un software de diseño digital, planificamos tu tratamiento de forma milimétrica. Te mostramos una simulación 3D de cómo quedará tu sonrisa final para que decidas con total seguridad y sin sorpresas.",
  },
  {
    number: "03",
    step: "Después",
    title: "Realizamos el procedimiento",
    subtitle: "Precisión digital, mínimo dolor.",
    image: "/images/journey-step3.png",
    description:
      "Utilizamos guías quirúrgicas impresas en 3D y protocolos mínimamente invasivos. Esto se traduce en un proceso mucho más rápido en el sillón, máxima precisión clínica y una recuperación notablemente más acelerada.",
  },
  {
    number: "04",
    step: "Finalmente",
    title: "Tu nueva sonrisa, para siempre",
    subtitle: "Garantía internacional de por vida.",
    image: "/images/journey-step4.png",
    description:
      "Colocamos implantes de las líneas premium líderes mundiales (Straumann® y Neodent®). Recuperás tu estética natural, tu confianza y tu calidad de vida, respaldado por una garantía internacional de por vida.",
  },
];
---

<section id="proceso" class="py-16 lg:py-24 bg-white overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span
        class="text-primary font-bold tracking-widest uppercase text-xs mb-3 block"
        >El proceso</span
      >
      <h2
        class="text-3xl md:text-4xl lg:text-5xl text-slate-900 font-bold mb-4"
      >
        Así funciona tu tratamiento
      </h2>
      <p class="text-slate-500 leading-relaxed">
        Cuatro pasos claros, sin sorpresas, diseñados para que llegues a tu
        nueva sonrisa con total confianza.
      </p>
    </div>

    {/* Carrusel */}
    <div class="relative max-w-5xl mx-auto">
      {/* Track deslizable */}
      <div
        id="journey-track"
        class="flex gap-5 transition-transform duration-500 ease-in-out will-change-transform"
      >
        {
          steps.map((step, i) => (
            <div
              class="journey-slide shrink-0 w-[85vw] sm:w-[420px] bg-white rounded-3xl border border-slate-100 shadow-[0_6px_30px_rgba(126,179,180,0.13)] overflow-hidden flex flex-col gap-0 transition-all duration-500"
              data-slide={i}
            >
              {/* Imagen del paso */}
              <div class="w-full aspect-video overflow-hidden">
                <img
                  src={step.image}
                  alt={step.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </div>

              {/* Contenido de la card */}
              <div class="p-8 flex flex-col gap-5 flex-1">
                {/* Header de la card */}
                <div class="flex items-start justify-between">
                  <span class="inline-block text-xs font-bold text-primary uppercase tracking-widest bg-primary/10 px-3 py-1 rounded-full">
                    {step.step}
                  </span>
                  <span class="text-5xl font-black text-slate-400 leading-none select-none -mt-1">
                    {step.number}
                  </span>
                </div>

                {/* Texto */}
                <div class="flex-1">
                  <p class="text-[11px] font-bold text-primary uppercase tracking-widest mb-2">
                    {step.subtitle}
                  </p>
                  <h3 class="text-xl font-bold text-slate-900 mb-3 leading-snug">
                    {step.title}
                  </h3>
                  <p class="text-slate-500 text-sm leading-relaxed">
                    {step.description}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {/* Controles */}
      <div class="flex items-center justify-between mt-8">
        {/* Puntos indicadores */}
        <div class="flex gap-2" id="journey-dots">
          {
            steps.map((_, i) => (
              <button
                class={`journey-dot rounded-full transition-all duration-300 ${i === 0 ? "w-6 h-2 bg-primary" : "w-2 h-2 bg-slate-300"}`}
                data-dot={i}
                aria-label={`Ir al paso ${i + 1}`}
              />
            ))
          }
        </div>

        {/* Flechas */}
        <div class="flex gap-3">
          <button
            id="journey-prev"
            class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:border-primary hover:text-primary transition-all duration-200 disabled:opacity-30 disabled:cursor-not-allowed"
            disabled
            aria-label="Anterior"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"><path d="m15 18-6-6 6-6"></path></svg
            >
          </button>
          <button
            id="journey-next"
            class="w-10 h-10 rounded-full border border-primary bg-primary text-primary-foreground flex items-center justify-center hover:bg-primary/90 transition-all duration-200"
            aria-label="Siguiente"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"><path d="m9 18 6-6-6-6"></path></svg
            >
          </button>
        </div>
      </div>
    </div>

    {/* CTA */}
    <div class="text-center mt-12">
      <a
        href={CLINIC_DATA.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-7 py-3.5 rounded-2xl font-semibold text-sm transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/20 shadow-md"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path></svg
        >
        Comenzar mi diagnóstico gratis
      </a>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("journey-track") as HTMLElement;
  const slides = document.querySelectorAll<HTMLElement>(".journey-slide");
  const dots = document.querySelectorAll<HTMLButtonElement>(".journey-dot");
  const prevBtn = document.getElementById("journey-prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("journey-next") as HTMLButtonElement;
  const total = slides.length;
  let current = 0;

  function getSlideWidth(): number {
    if (!slides[0]) return 0;
    return slides[0].offsetWidth + 20; // width + gap (gap-5 = 20px)
  }

  function goTo(index: number) {
    current = Math.max(0, Math.min(index, total - 1));
    track.style.transform = `translateX(-${current * getSlideWidth()}px)`;

    // Update dots
    dots.forEach((dot, i) => {
      if (i === current) {
        dot.classList.add("w-6", "bg-primary");
        dot.classList.remove("w-2", "bg-slate-300");
      } else {
        dot.classList.remove("w-6", "bg-primary");
        dot.classList.add("w-2", "bg-slate-300");
      }
    });

    // Update slides opacity
    slides.forEach((slide, i) => {
      slide.style.opacity = i === current ? "1" : "0.5";
      slide.style.scale = i === current ? "1" : "0.97";
    });

    // Update buttons
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current === total - 1;
    if (current === total - 1) {
      nextBtn.classList.add("opacity-30", "cursor-not-allowed");
    } else {
      nextBtn.classList.remove("opacity-30", "cursor-not-allowed");
    }
  }

  prevBtn.addEventListener("click", () => goTo(current - 1));
  nextBtn.addEventListener("click", () => goTo(current + 1));
  dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

  // Swipe support
  let startX = 0;
  track.addEventListener(
    "touchstart",
    (e) => {
      startX = e.touches[0].clientX;
    },
    { passive: true },
  );
  track.addEventListener("touchend", (e) => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
  });

  // Init
  goTo(0);
</script>
