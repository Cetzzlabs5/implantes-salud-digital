---
import { CLINIC_DATA } from '../../lib/constants';
import { Scan, Laptop, Target, Smile, MessageCircle } from 'lucide-react';

const steps = [
  {
    title: 'Diagnóstico 3D',
    description: 'Ves tu boca en pantalla 3D al instante, sin radiación excesiva.',
    icon: Scan,
    color: 'text-blue-500',
    bgColor: 'bg-blue-50',
    borderColor: 'border-blue-100'
  },
  {
    title: 'Simulación Digital',
    description: 'Te mostramos cómo quedará tu sonrisa antes de iniciar cualquier tratamiento.',
    icon: Laptop,
    color: 'text-indigo-500',
    bgColor: 'bg-indigo-50',
    borderColor: 'border-indigo-100'
  },
  {
    title: 'Procedimiento Guiado',
    description: 'Precisión milimétrica que reduce el dolor y acelera drásticamente la recuperación.',
    icon: Target,
    color: 'text-primary',
    bgColor: 'bg-primary/10',
    borderColor: 'border-primary/20'
  },
  {
    title: 'Sonrisa Definitiva',
    description: 'Resultados estéticos de máxima calidad con materiales premium.',
    icon: Smile,
    color: 'text-emerald-500',
    bgColor: 'bg-emerald-50',
    borderColor: 'border-emerald-100'
  }
];
---

<section class="py-16 lg:py-24 bg-slate-50 relative overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-24">
      <span class="text-primary font-bold tracking-wider uppercase text-sm mb-4 block">Adiós a la Incertidumbre</span>
      <h2 class="font-['Outfit'] text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
        Tu Experiencia, Sin Dolor
      </h2>
      <p class="text-lg text-slate-600 font-['Inter']">
        Sabemos que ir al dentista puede generar ansiedad. Por eso, hemos diseñado un proceso 100% digital, predecible y mínimamente invasivo.
      </p>
    </div>

    <div class="max-w-3xl mx-auto relative">
      {/* Timeline Vertical Line */}
      <div class="absolute left-8 md:left-12 top-10 bottom-10 w-1 bg-gradient-to-b from-slate-200 via-primary/30 to-transparent rounded-full hidden sm:block"></div>
      
      <div class="space-y-12 md:space-y-16 relative z-10">
        {steps.map((step, index) => {
          const Icon = step.icon;
          return (
            <div class="flex flex-col sm:flex-row gap-6 md:gap-12 group">
              {/* Icon / Marker */}
              <div class="shrink-0 relative sm:ml-2">
                <div class={`w-16 h-16 md:w-20 md:h-20 rounded-2xl flex items-center justify-center ${step.bgColor} border-2 ${step.borderColor} shadow-sm z-10 relative transition-all duration-500 group-hover:scale-110 group-hover:-rotate-3`}>
                  <Icon className={`w-8 h-8 md:w-10 md:h-10 ${step.color}`} />
                </div>
                {/* Number Badge */}
                <div class="absolute -top-3 -right-3 md:-top-4 md:-right-4 w-8 h-8 md:w-10 md:h-10 rounded-full bg-slate-900 text-white flex items-center justify-center text-sm md:text-base font-bold shadow-lg border-2 border-slate-50 group-hover:bg-primary transition-colors duration-300">
                  {index + 1}
                </div>
              </div>
              
              {/* Content Box */}
              <div class="flex-grow bg-white p-6 md:p-8 rounded-[2rem] shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative">
                {/* Decorative arrow pointing to icon (desktop only) */}
                <div class="hidden sm:block absolute top-8 -left-3 w-6 h-6 bg-white border-l border-b border-slate-100 transform rotate-45"></div>
                
                <h3 class="font-['Outfit'] text-2xl font-bold text-slate-900 mb-3 group-hover:text-primary transition-colors">
                  {step.title}
                </h3>
                <p class="text-slate-600 leading-relaxed font-['Inter'] md:text-lg">
                  {step.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-16 text-center sm:pl-32">
        <a 
          href={CLINIC_DATA.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-slate-900 text-white px-8 py-4.5 rounded-full font-semibold text-lg hover:bg-primary transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-1"
        >
          <MessageCircle className="w-5 h-5" />
          Comienza tu Transformación
        </a>
      </div>
    </div>
  </div>
</section>
