---
import { CLINIC_DATA } from '../../lib/constants';
import { MessageCircle, ArrowRight, Users, Award, ShieldCheck } from 'lucide-react';
---

<section class="relative bg-[#f8fafc] py-16 lg:py-24 overflow-hidden z-0">
  {/* Efecto Glow Sutil (Radial Gradients) */}
  <div class="absolute top-1/4 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/10 rounded-full blur-[100px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-0 right-0 translate-x-1/4 translate-y-1/4 w-[800px] h-[800px] bg-accent/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-12 items-center">
      
      {/* Columna de Contenido */}
      <div class="max-w-2xl relative z-20">
        
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/60 backdrop-blur-md border border-white shadow-sm text-primary text-sm font-semibold mb-8 transition-transform hover:-translate-y-0.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          Agenda Abierta 2026
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-[4rem] text-slate-900 leading-[1.05] mb-6">
          Odontología Digital de Vanguardia. <br class="hidden lg:block"/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-600 block mt-2">
            Resultados para toda la vida.
          </span>
        </h1>
        
        <p class="text-lg md:text-xl text-slate-600 mb-10 leading-relaxed max-w-xl">
          Transformamos tu sonrisa con tecnología 3D, sin dolor y en menos tiempo. Respaldados por 22 años de experiencia y certificación internacional ISO 9001.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-5 mb-14">
          {/* Botón Principal Premium */}
          <a 
            href={CLINIC_DATA.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-center gap-2 bg-gradient-to-b from-primary to-blue-900 text-white px-8 py-4 rounded-full font-semibold text-lg border border-blue-400/30 transition-all duration-300 shadow-[0_8px_20px_rgba(4,43,89,0.25)] hover:shadow-[0_12px_25px_rgba(4,43,89,0.4)] hover:-translate-y-1 overflow-hidden"
          >
            {/* Brillo dinámico hover */}
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></span>
            
            <MessageCircle className="w-5 h-5 relative z-10" />
            <span class="relative z-10">Agenda tu Consulta</span>
          </a>
          
          {/* Botón Secundario */}
          <a 
            href="#casos-de-exito" 
            class="inline-flex items-center justify-center gap-2 bg-white/60 backdrop-blur-sm text-slate-800 border border-slate-200 px-8 py-4 rounded-full font-semibold text-lg transition-all duration-300 hover:bg-white hover:border-slate-300 hover:shadow-md hover:-translate-y-1"
          >
            Ver Casos de Éxito
            <ArrowRight className="w-5 h-5 text-slate-400 group-hover:text-slate-800" />
          </a>
        </div>
        
        {/* Trust Badges con Glassmorphism */}
        <div>
          <p class="text-xs font-bold text-slate-400 mb-4 uppercase tracking-widest ml-1">Estándar de Excelencia</p>
          <div class="flex flex-wrap gap-4">
            {/* Badge 1 */}
            <div class="flex items-center gap-3 bg-white/40 backdrop-blur-md border border-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] px-4 py-3 rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:bg-white/60 hover:shadow-lg">
              <div class="bg-blue-50 p-2 rounded-xl text-blue-600">
                <Users className="w-5 h-5" />
              </div>
              <span class="text-sm font-semibold text-slate-800 leading-tight">+11,000<br/><span class="font-medium text-slate-500 text-xs">Pacientes anuales</span></span>
            </div>
            
            {/* Badge 2 */}
            <div class="flex items-center gap-3 bg-white/40 backdrop-blur-md border border-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] px-4 py-3 rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:bg-white/60 hover:shadow-lg">
              <div class="bg-yellow-50 p-2 rounded-xl text-yellow-600">
                <Award className="w-5 h-5" />
              </div>
              <span class="text-sm font-semibold text-slate-800 leading-tight">ISO 9001<br/><span class="font-medium text-slate-500 text-xs">Certificado</span></span>
            </div>
            
            {/* Badge 3 */}
            <div class="flex items-center gap-3 bg-white/40 backdrop-blur-md border border-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] px-4 py-3 rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:bg-white/60 hover:shadow-lg">
              <div class="bg-slate-100 p-2 rounded-xl text-slate-600">
                <ShieldCheck className="w-5 h-5" />
              </div>
              <span class="text-sm font-semibold text-slate-800 leading-tight">Socios<br/><span class="font-medium text-slate-500 text-xs">Straumann Group</span></span>
            </div>
          </div>
        </div>
      </div>
      
      {/* Columna de Imagen */}
      <div class="relative w-full max-w-[600px] mx-auto lg:mx-0 mt-8 lg:mt-0 z-20 perspective-1000">
        
        {/* Glow específico detrás de la imagen */}
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/30 to-blue-400/20 rounded-[2.5rem] transform rotate-3 scale-105 opacity-60 blur-2xl -z-10"></div>
        
        <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(8,_112,_184,_0.15)] border-4 border-white group transform transition-transform duration-700 hover:rotate-y-2 hover:scale-[1.02]">
          <img 
            src="/images/hero.png" 
            alt="Consultorio Odontológico Premium" 
            class="w-full h-auto object-cover aspect-[4/3] md:aspect-square lg:aspect-[4/5] scale-105 group-hover:scale-100 transition-transform duration-1000 ease-out"
          />
          
          {/* Floating Badge (Top Right) Glassmorphism */}
          <div class="absolute top-6 right-6 bg-white/70 backdrop-blur-md border border-white shadow-xl p-3 rounded-2xl flex items-center gap-3 transform transition-transform hover:-translate-y-1">
            <div class="flex -space-x-2">
              <img class="w-8 h-8 rounded-full border-2 border-white shadow-sm" src="https://i.pravatar.cc/100?img=1" alt="Patient" />
              <img class="w-8 h-8 rounded-full border-2 border-white shadow-sm" src="https://i.pravatar.cc/100?img=2" alt="Patient" />
              <img class="w-8 h-8 rounded-full border-2 border-white shadow-sm" src="https://i.pravatar.cc/100?img=3" alt="Patient" />
            </div>
            <div class="text-xs font-bold text-slate-800 pr-1">
              5.0 ⭐⭐⭐⭐⭐<br/><span class="text-slate-500 font-medium">Google Reviews</span>
            </div>
          </div>

          {/* Floating Badge (Bottom Left) */}
          <div class="absolute -bottom-6 -left-6 md:left-auto md:-right-6 bg-white p-4 rounded-2xl shadow-2xl flex items-center gap-4 animate-[float_4s_ease-in-out_infinite] z-20 hidden sm:flex border border-slate-100">
            <div class="bg-green-100 p-3 rounded-full text-green-600 shadow-inner">
              <ShieldCheck className="w-6 h-6" />
            </div>
            <div>
              <p class="text-xs text-slate-500 font-medium">Garantía de</p>
              <p class="text-sm font-bold text-slate-900">Por Vida</p>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
</style>
