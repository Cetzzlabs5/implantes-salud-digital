---
import { CLINIC_DATA } from '../../lib/constants';
import { Sparkles, Smile, Activity, Wand2, ArrowRight } from 'lucide-react';

const phone = CLINIC_DATA.phone.replace('+', ''); // Strip + for wa.me link

const services = [
  {
    title: 'Implantes Dentales',
    description: 'Recupera la funcionalidad y estética de tu boca con implantes de titanio de máxima pureza. Una solución definitiva y natural.',
    icon: Activity,
    highlight: 'Tratamiento Estrella',
    msg: 'Hola, me gustaría saber más sobre el tratamiento de Implantes Dentales.'
  },
  {
    title: 'Diseño de Sonrisa',
    description: 'Logra la sonrisa perfecta en pocas sesiones con carillas de porcelana ultra finas. Diseño computarizado para resultados exactos.',
    icon: Smile,
    msg: 'Hola, me gustaría saber más sobre el Diseño de Sonrisa y Carillas.'
  },
  {
    title: 'Ortodoncia',
    description: 'Alineación dental invisible y tradicional para corregir tu mordida de forma efectiva y estética. Resultados visibles en menos tiempo.',
    icon: Wand2,
    msg: 'Hola, me gustaría saber más sobre los tratamientos de Ortodoncia.'
  },
  {
    title: 'Armonización Facial',
    description: 'Procedimientos estéticos no invasivos para resaltar tus rasgos y rejuvenecer tu rostro, logrando un equilibrio perfecto.',
    icon: Sparkles,
    msg: 'Hola, me gustaría saber más sobre Armonización Facial.'
  }
];
---

<section id="especialidades" class="py-16 lg:py-24 bg-white relative">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-24">
      <h2 class="text-3xl md:text-4xl lg:text-5xl text-slate-900 mb-6">
        Especialidades de Nivel Internacional
      </h2>
      <p class="text-lg text-slate-600">
        Brindamos soluciones integrales con los más altos estándares de calidad, enfocándonos en tu bienestar a largo plazo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8 group/grid">
      {services.map((service) => {
        const Icon = service.icon;
        const isHighlighted = !!service.highlight;
        
        return (
          <a 
            href={`https://wa.me/${phone}?text=${encodeURIComponent(service.msg)}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`relative flex flex-col group/card rounded-[2rem] p-8 cursor-pointer transition-all duration-500 
              group-hover/grid:opacity-60 hover:!opacity-100 hover:-translate-y-2
              ${isHighlighted 
                ? 'bg-gradient-to-b from-white to-accent/5 border-2 border-accent shadow-xl hover:shadow-2xl hover:shadow-primary/20 hover:border-primary' 
                : 'bg-white border border-slate-100 shadow-sm hover:shadow-xl hover:border-slate-300'
              }`
            }
          >
            
            {/* Badge Highlight */}
            {isHighlighted && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-accent text-accent-foreground text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider flex items-center gap-1 shadow-md whitespace-nowrap transition-colors duration-500 group-hover/card:bg-primary group-hover/card:text-white">
                <Sparkles className="w-3 h-3" />
                {service.highlight}
              </div>
            )}
            
            {/* Icon Container */}
            <div class={`w-14 h-14 rounded-2xl flex items-center justify-center mb-6 transition-colors duration-500 ${
              isHighlighted ? 'bg-accent/20 text-accent-foreground group-hover/card:bg-primary group-hover/card:text-white' : 'bg-slate-50 text-primary group-hover/card:bg-primary group-hover/card:text-white'
            }`}>
              <Icon className="w-7 h-7" />
            </div>
            
            {/* Titulo */}
            <h3 class="text-xl font-bold text-slate-900 mb-3 transition-colors duration-500 group-hover/card:text-primary">
              {service.title}
            </h3>
            
            {/* Descripción */}
            <p class="text-slate-600 leading-relaxed text-sm mb-8 flex-grow">
              {service.description}
            </p>
            
            {/* Footer de la Tarjeta (CTA Dinámico) */}
            <div class="pt-4 mt-auto border-t border-slate-100/50">
              <div class={`inline-flex w-full items-center justify-between text-sm font-semibold transition-colors duration-500 ${
                  isHighlighted ? 'text-accent-foreground group-hover/card:text-primary' : 'text-primary group-hover/card:text-slate-900'
                }`}
              >
                Saber más
                
                {/* Contenedor del ícono flecha (Efecto Slide-in) */}
                <span class={`w-8 h-8 flex items-center justify-center rounded-full overflow-hidden relative transition-colors duration-500 ${
                  isHighlighted ? 'bg-accent/10 group-hover/card:bg-primary/10' : 'bg-slate-50 group-hover/card:bg-primary/10'
                }`}>
                  {/* Flecha que entra desde la izquierda */}
                  <ArrowRight className="w-4 h-4 absolute transform -translate-x-full opacity-0 group-hover/card:translate-x-0 group-hover/card:opacity-100 transition-all duration-500 ease-out text-primary" />
                  
                  {/* Flecha actual que sale hacia la derecha */}
                  <ArrowRight className="w-4 h-4 transform group-hover/card:translate-x-full group-hover/card:opacity-0 transition-all duration-500 ease-out text-current" />
                </span>
              </div>
            </div>
          </a>
        )
      })}
    </div>
  </div>
</section>
