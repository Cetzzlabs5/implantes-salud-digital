---
import { ShieldCheck, Building2, BadgeCheck } from "lucide-react";
---

<section
  id="cobertura"
  class="py-14 lg:py-20 bg-background relative overflow-hidden"
>
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    {/* ── HEADER ── */}
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span
        class="text-primary font-bold tracking-widest uppercase text-xs mb-4 block"
        >Respaldo & Cobertura</span
      >
      <h2
        class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 leading-tight"
      >
        Certificados internacionales <br class="hidden sm:block" />
        <span class="text-primary">y tu obra social incluida</span>
      </h2>
      <p class="text-slate-600 text-base">
        Trabajamos con los mejores socios del mundo y con las principales obras
        sociales de la región para que ningún costo sea un obstáculo.
      </p>
    </div>

    {/* ── BLOQUE SUPERIOR: AVALES INTERNACIONALES ── */}
    <div
      class="max-w-5xl mx-auto rounded-3xl border border-primary/10 bg-primary/10 p-8 mb-8 shadow-[0_4px_30px_rgba(126,179,180,0.10)]"
    >
      <div class="flex items-center gap-2 mb-6">
        <BadgeCheck className="w-5 h-5 text-primary" />
        <p
          class="text-xs font-extrabold uppercase tracking-widest text-primary"
        >
          Avales & Socios Internacionales
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {/* ISO 9001 */}
        <div
          class="flex flex-col items-center justify-center gap-4 py-10 px-8 rounded-3xl bg-white border border-primary/10 hover:border-primary/30 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-[0_8px_30px_rgba(126,179,180,0.15)]"
        >
          <div class="w-full flex items-center justify-center">
            <img
              src="/images/ISO-9001.png"
              alt="Certificación ISO 9001"
              class="h-20 w-auto max-w-[160px] object-contain"
              style="mix-blend-mode: multiply;"
            />
          </div>
          <div class="text-center">
            <span
              class="text-xs font-extrabold uppercase tracking-widest text-primary block"
              >ISO 9001</span
            >
            <span class="text-[11px] font-semibold text-slate-400 tracking-wide"
              >Certificados</span
            >
          </div>
        </div>

        {/* Straumann Group */}
        <div
          class="flex flex-col items-center justify-center gap-4 py-10 px-8 rounded-3xl bg-white border border-primary/10 hover:border-primary/30 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-[0_8px_30px_rgba(126,179,180,0.15)]"
        >
          <div class="w-full flex items-center justify-center">
            <img
              src="/images/straumann.png"
              alt="Straumann Group"
              class="h-20 w-auto max-w-[180px] object-contain"
              style="mix-blend-mode: multiply;"
            />
          </div>
          <div class="text-center">
            <span
              class="text-xs font-extrabold uppercase tracking-widest text-primary block"
              >Straumann Group</span
            >
            <span class="text-[11px] font-semibold text-slate-400 tracking-wide"
              >Socios Oficiales</span
            >
          </div>
        </div>

        {/* Neodent® */}
        <div
          class="flex flex-col items-center justify-center gap-4 py-10 px-8 rounded-3xl bg-white border border-primary/10 hover:border-primary/30 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-[0_8px_30px_rgba(126,179,180,0.15)]"
        >
          <div class="w-full flex items-center justify-center">
            <img
              src="/images/neodent.png"
              alt="Neodent® Implants"
              class="h-20 w-auto max-w-[180px] object-contain"
              style="mix-blend-mode: multiply;"
            />
          </div>
          <div class="text-center">
            <span
              class="text-xs font-extrabold uppercase tracking-widest text-primary block"
              >Neodent®</span
            >
            <span class="text-[11px] font-semibold text-slate-400 tracking-wide"
              >Premium Implants</span
            >
          </div>
        </div>
      </div>
    </div>

    {/* ── BLOQUE INFERIOR: OBRAS SOCIALES ── */}
    <div
      class="max-w-5xl mx-auto rounded-3xl border border-slate-100 bg-primary/10 p-8 shadow-sm"
    >
      <div class="flex items-center gap-2 mb-2">
        <ShieldCheck className="w-5 h-5 text-primary" />
        <p
          class="text-xs font-extrabold uppercase tracking-widest text-primary"
        >
          Obras Sociales con Convenio Directo
        </p>
      </div>
      <p class="text-sm text-slate-500 mb-6 max-w-xl">
        Además, atendemos a todos los afiliados de obras sociales vinculadas a
        la <strong>Asociación Odontológica Salteña</strong> y al <strong
          >Círculo Odontológico Salteño</strong
        >.
      </p>

      {/* Chips de obras sociales con convenio directo */}
      <div class="flex flex-wrap gap-3 mb-8">
        {/* Prevención Salud */}
        <div
          class="inline-flex items-center gap-2.5 bg-white border border-primary/20 rounded-full px-5 py-2.5 shadow-sm hover:shadow-md hover:border-primary/50 hover:-translate-y-0.5 transition-all duration-300 group"
        >
          <span
            class="w-2.5 h-2.5 rounded-full bg-primary/60 group-hover:bg-primary transition-colors shrink-0"
          ></span>
          <span class="font-semibold text-slate-800 text-sm"
            >Prevención Salud</span
          >
        </div>

        {/* Avalian */}
        <div
          class="inline-flex items-center gap-2.5 bg-white border border-primary/20 rounded-full px-5 py-2.5 shadow-sm hover:shadow-md hover:border-primary/50 hover:-translate-y-0.5 transition-all duration-300 group"
        >
          <span
            class="w-2.5 h-2.5 rounded-full bg-primary/60 group-hover:bg-primary transition-colors shrink-0"
          ></span>
          <span class="font-semibold text-slate-800 text-sm">Avalian</span>
        </div>

        {/* Amsterdam */}
        <div
          class="inline-flex items-center gap-2.5 bg-white border border-primary/20 rounded-full px-5 py-2.5 shadow-sm hover:shadow-md hover:border-primary/50 hover:-translate-y-0.5 transition-all duration-300 group"
        >
          <span
            class="w-2.5 h-2.5 rounded-full bg-primary/60 group-hover:bg-primary transition-colors shrink-0"
          ></span>
          <span class="font-semibold text-slate-800 text-sm">Amsterdam</span>
        </div>

        {/* Boreal */}
        <div
          class="inline-flex items-center gap-2.5 bg-white border border-primary/20 rounded-full px-5 py-2.5 shadow-sm hover:shadow-md hover:border-primary/50 hover:-translate-y-0.5 transition-all duration-300 group"
        >
          <span
            class="w-2.5 h-2.5 rounded-full bg-primary/60 group-hover:bg-primary transition-colors shrink-0"
          ></span>
          <span class="font-semibold text-slate-800 text-sm">Boreal</span>
        </div>
      </div>
    </div>
  </div>
</section>
